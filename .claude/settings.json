{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "spinnerTipsEnabled": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(cargo *)",
      "Bash(git *)",
      "Bash(./scripts/*)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(stat *)",
      "Bash(test *)",
      "Bash(flock *)",
      "Bash(cd *)",
      "Bash(gh *)",
      "Bash(chmod *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(tee *)",
      "Bash(xargs *)",
      "Bash(touch *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(pwd)",
      "Bash(env *)",
      "Bash(which *)",
      "Bash(rm *)",
      "Task(**)",
      "Bash(./tools/tszd/*)",
      "Bash(tools/tszd/*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: commit and sync with main when work is done.'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'TSZ startup: run tsz-worktree-intake; read docs/plan/ROADMAP.md for the four goals (green, fast, grow, hold).'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ \"${TSZ_FAST_LOOP:-1}\" = 0 ] || ./tools/tszd/ra up >/dev/null 2>&1 || true'",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | grep -q '\\.rs$' && cargo fmt --quiet || exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Claude Code is waiting for attention (idle prompt). Make sure to commit and sync with main when work is done."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/tszd/cargo_gate.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "explanatory-output-style@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "rust-skills@rust-skills": true
  }
}
